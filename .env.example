# Copy to .env and fill in values.
# All variables are validated at startup — missing required values will raise immediately.

# --- Environment ---
# Exactly one must be true.
ON_LOCAL=true
ON_STAGING=false
ON_LIVE=false

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# --- Database ---
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Frontend (Next.js) ---
# Consumed by the web/ app. Copy to web/.env.local if needed.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Origins ---
# ALLOWED_HOSTS: comma-separated. Required on staging/live.
ALLOWED_HOSTS=
# Frontend origin. Defaults to http://localhost:3000 on local.
FRONTEND_BASE_URL=

# --- Email ---
# Leave blank to use the console backend (development default).
# Set EMAIL_BACKEND to configure a real provider.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
